# 后端服务配置(可选,留空使用默认值)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 首次启动管理员账号（密码至少 12 位；创建成功后不会覆盖现有账号）
INSECT_BOOTSTRAP_ADMIN_USERNAME=
INSECT_BOOTSTRAP_ADMIN_PASSWORD=

# 登录会话
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24
DEFAULT_USER_QUOTA=100

# 前端开发服务器(仅开发时使用,前端会通过 vite proxy 转发 /api 到后端)

# 模型调用内部常量(可选,留空使用默认值)
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# 图片预处理(可选)
IMAGE_MAX_LONG_EDGE=3000
IMAGE_JPEG_QUALITY=90

# v1.3.11 上传预压缩标准化(门槛式)
# 长边 1600 落在主流多模态 API 公共有效区间(GPT 2048 上限/DeepSeek 缩至约 800)
# 设为 0 不缩放仅转码;MATERIAL_STANDARDIZE_ENABLED=false 一键退回旧行为
MATERIAL_STANDARDIZE_ENABLED=true
MATERIAL_STANDARDIZE_LONG_EDGE=1600
MATERIAL_STANDARDIZE_JPEG_QUALITY=85
MATERIAL_STANDARDIZE_MIN_SAVING_RATIO=0.85
MATERIAL_STANDARDIZE_MEMORY_BACKOFF_SECONDS=2.0

# 本地 OCR 识别增强(失败时自动回退到纯视觉模型)
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45

# 开发模式 CORS 允许的前端地址
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
