# 后端服务配置(可选,留空使用默认值)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 首次启动管理员账号（密码至少 12 位；创建成功后不会覆盖现有账号）
INSECT_BOOTSTRAP_ADMIN_USERNAME=
INSECT_BOOTSTRAP_ADMIN_PASSWORD=

# 登录会话
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24
DEFAULT_USER_QUOTA=100

# 前端开发服务器(仅开发时使用,前端会通过 vite proxy 转发 /api 到后端)

# 模型调用内部常量(可选,留空使用默认值)
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2

# 图片预处理(可选)
IMAGE_MAX_LONG_EDGE=3000
IMAGE_JPEG_QUALITY=90

# v1.3.11 上传预压缩标准化(门槛式)
# 长边 1600 落在主流多模态 API 公共有效区间(GPT 2048 上限/DeepSeek 缩至约 800)
# 设为 0 不缩放仅转码;MATERIAL_STANDARDIZE_ENABLED=false 一键退回旧行为
MATERIAL_STANDARDIZE_ENABLED=true
MATERIAL_STANDARDIZE_LONG_EDGE=1600
MATERIAL_STANDARDIZE_JPEG_QUALITY=85
MATERIAL_STANDARDIZE_MIN_SAVING_RATIO=0.85
MATERIAL_STANDARDIZE_MEMORY_BACKOFF_SECONDS=2.0

# v1.3.12 摄取任务看门狗:processing 超过该秒数无进度更新的任务自动回收,
# 防止线程异常死亡后上传被 409 锁死(0=关闭)
MATERIAL_INGEST_STALE_JOB_SECONDS=900

# 后台预取(下一张秒开的关键产能配置)
# 产能估算 = 并发数 / 单次模型调用秒数 × 60;消费节奏 3 秒/张 = 20 张/分
# 推荐:并发 12 + 总槽 13(自动留 1 槽给前台),实测 3 秒/张全程秒开
# 总调用数不变(每张恰好一次),并发只是提前准备;受模型 API 限流约束可下调
# httpx 连接池需 ≥ 并发数,否则实际并发被连接池钉住
MATERIAL_PREFETCH_CONCURRENCY=12
RESOURCE_RECOGNITION_SLOTS=13
MODEL_HTTP_MAX_CONNECTIONS=16
MODEL_HTTP_MAX_KEEPALIVE_CONNECTIONS=12
# 后台最多占用槽位(>0 显式上限;0=自动:跟随并发并给前台留位,v1.3.13 默认)
RESOURCE_BACKGROUND_MAX_SLOTS=0

# 本地 OCR 识别增强(失败时自动回退到纯视觉模型)
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.45

# 开发模式 CORS 允许的前端地址
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
